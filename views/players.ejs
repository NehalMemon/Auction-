<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Players | Auction System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-900 text-gray-100 font-sans antialiased">

    <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-50 w-full max-w-md px-4 space-y-4">
        <% if (locals.success_msg && locals.success_msg.length > 0) { %>
            <div class="bg-green-500/10 border-l-4 border-green-500 text-green-400 p-4 rounded shadow-2xl backdrop-blur-sm flex items-center justify-between animate-bounce" role="alert">
                <div><span class="font-bold">Success:</span> <%= success_msg %></div>
            </div>
        <% } %>
        <% if (locals.error_msg && locals.error_msg.length > 0) { %>
            <div class="bg-red-500/10 border-l-4 border-red-500 text-red-400 p-4 rounded shadow-2xl backdrop-blur-sm flex items-center justify-between" role="alert">
                <div><span class="font-bold">Error:</span> <%= error_msg %></div>
            </div>
        <% } %>
    </div>

    <div class="flex h-screen overflow-hidden">
        <aside class="w-64 bg-gray-800 border-r border-gray-700 hidden md:flex flex-col">
            <div class="h-16 flex items-center justify-center border-b border-gray-700">
                <h1 class="text-2xl font-bold text-blue-500 tracking-wider">AUCTION<span class="text-white">PRO</span></h1>
            </div>
            <nav class="flex-1 px-4 py-6 space-y-2">
                <a href="/admin/dashboard" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors">
                    <i class="fas fa-th-large w-6"></i> <span class="ml-3 font-medium">Dashboard</span>
                </a>
                <a href="/player/playerslist" class="flex items-center px-4 py-3 bg-gray-700 text-white rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-running w-6"></i> <span class="ml-3 font-medium">Players</span>
                </a>
            </nav>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden relative">
            
            <header class="h-16 bg-gray-800 border-b border-gray-700 flex items-center justify-between px-8">
                <h2 class="text-xl font-semibold text-gray-200">Manage Players</h2>
                <a href="/auth/player/register" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all shadow-md">
                    <i class="fas fa-plus mr-2"></i> Add Player
                </a>
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-900 p-8">
                
                <div class="bg-gray-800 rounded-xl border border-gray-700 shadow-xl overflow-hidden">
                    
                    <% if (players.length === 0) { %>
                        <div class="p-12 text-center text-gray-500">
                            <div class="mb-4 bg-gray-700/50 h-20 w-20 rounded-full flex items-center justify-center mx-auto">
                                <i class="fas fa-user-slash text-3xl"></i>
                            </div>
                            <h4 class="text-xl font-medium text-white">No Players Found</h4>
                            <p class="mt-2 text-sm">Start by adding a new player to the auction pool.</p>
                        </div>
                    <% } else { %>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-gray-700/50 text-xs uppercase text-gray-400 font-semibold tracking-wider">
                                    <tr>
                                        <th class="px-6 py-4">Player Name</th>
                                        <th class="px-6 py-4">Role</th>
                                        <th class="px-6 py-4">Category</th>
                                        <th class="px-6 py-4">Status</th>
                                        <th class="px-6 py-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-700">
                                    <% players.forEach(player => { %>
                                        <tr class="hover:bg-gray-700/30 transition-colors">
                                            
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="flex items-center">
                                                    <div class="h-10 w-10 rounded-full bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center text-white font-bold text-sm shadow-md">
                                                        <%= player.name.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <div class="ml-4">
                                                        <div class="text-sm font-medium text-white"><%= player.name %></div>
                                                        <div class="text-xs text-gray-400"><%= player.playingStyle %></div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-900/30 text-blue-400 border border-blue-800">
                                                    <%= player.category %>
                                                </span>
                                            </td>

                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <% 
                                                    let tierColor = 'text-gray-400 border-gray-600 bg-gray-800'; 
                                                    if(player.auctionCategory === 'Platinum') tierColor = 'text-gray-900 bg-slate-200 border-slate-300 font-bold'; 
                                                    if(player.auctionCategory === 'Diamond') tierColor = 'text-purple-300 bg-purple-900/40 border-purple-700';
                                                    if(player.auctionCategory === 'Gold') tierColor = 'text-yellow-400 bg-yellow-900/30 border-yellow-700';
                                                %>
                                                <span class="px-3 py-1 text-xs rounded-full border <%= tierColor %>">
                                                    <%= player.auctionCategory %>
                                                </span>
                                            </td>

                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <% if (player.isSold) { %>
                                                    <div class="flex items-center text-green-400 text-sm">
                                                        <span class="h-2 w-2 rounded-full bg-green-500 mr-2"></span> Sold
                                                    </div>
                                                <% } else { %>
                                                    <div class="flex items-center text-gray-400 text-sm">
                                                        <span class="h-2 w-2 rounded-full bg-gray-500 mr-2"></span> Unsold
                                                    </div>
                                                <% } %>
                                            </td>

                                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                                <a href="/admin/players/<%= player.id %>" class="text-white bg-gray-700 hover:bg-gray-600 px-3 py-1.5 rounded-lg text-xs transition-colors border border-gray-600">
                                                    View Profile
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>
</body>
</html>