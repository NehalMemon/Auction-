                        <!-- gemini code starts -->

                        <!-- for md and big screen view -->
                        <div class="overflow-hidden">
    <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead class="bg-gray-700/50 text-xs uppercase text-gray-400 font-semibold tracking-wider">
                <tr>
                    <th class="px-6 py-4">Player Name</th>
                    <th class="px-6 py-4">Role</th>
                    <th class="px-6 py-4 text-center">Category</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
                <% players.forEach(player => { %>
                    <tr class="hover:bg-gray-700/30 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div class="h-12 w-12 flex-shrink-0 rounded-full flex items-center justify-center shadow-md border border-gray-600 overflow-hidden">
                                     <img src="<%= player.playerImage %>" class="h-full w-full object-cover" alt="<%= player.name %>">
                                </div>
                                <div class="ml-4">
                                    <div class="text-sm font-medium text-white"><%= player.name %></div>
                                    <div class="text-xs text-gray-400"><%= player.playingStyle %></div>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center gap-2">
                                <% if (player.category === 'Batsman') { %>
                                    <img src="/images/cricket-icons/bat.png" class="w-10 h-8">
                                <% } else if (player.category === 'Bowler') { %>
                                    <img src="/images/cricket-icons/Ball.png" class="w-8 h-8">
                                <% } else if (player.category === 'All-rounder') { %>
                                    <img src="/images/cricket-icons/BatsAndBoll.png" class="w-10 h-8">
                                <% } else if (player.category === 'Wicket-keeper-batsman') { %>
                                    <img src="/images/cricket-icons/Bat.png" class="w-8 h-8">
                                    <img src="/images/cricket-icons/glovesGreen.png" class="w-8 h-8">
                                <% } %>
                            </span>
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap text-center">
                            <% 
                                let tierColor = 'text-slate-300 border-white/40 bg-slate-600/60  px-6 py-1'; 
                                if(player.auctionCategory === 'Platinum') tierColor = 'text-blue-400 bg-blue-900/40 border-blue-700 font-bold px-3 py-1'; 
                                else if(player.auctionCategory === 'Diamond') tierColor = 'text-purple-400 bg-purple-900/40 border-purple-700 px-3 py-1';
                                else if(player.auctionCategory === 'Gold') tierColor = 'text-yellow-400 bg-yellow-900/30 border-yellow-700  px-6 py-1';
                            %>
                            <span class="text-[10px] uppercase tracking-wider px-3 py-1 rounded-full border <%= tierColor %>">
                                <%= player.auctionCategory %>
                            </span>
                        </td>
                        
                        

                        <td class="px-6 py-4 whitespace-nowrap">
                            <% if (player.isSold) { %>
                                <span class="flex items-center text-green-400 text-sm">
                                    <span class="h-2 w-2 rounded-full bg-green-500 mr-2"></span> Sold
                                </span>
                            <% } else { %>
                                <span class="flex items-center text-gray-400 text-sm">
                                    <span class="h-2 w-2 rounded-full bg-gray-500 mr-2"></span> Unsold
                                </span>
                            <% } %>
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="/player/profile/<%= player.hashedId %>" class="text-white bg-gray-700 hover:bg-gray-600 px-3 py-1.5 rounded-lg text-xs transition-colors border border-gray-600">
                                View
                            </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

                        <!-- for sm and small screen view -->

    <div class="sm:hidden bg-red-500/50 grid grid-cols-1 divide-y divide-gray-700">
        <% players.forEach(player => { %>
            <div class="p-4 flex items-center justify-between hover:bg-gray-700/20">
                <div class="flex items-center space-x-3">
                    <img src="<%= player.playerImage %>" class="h-12 w-12 rounded-full object-cover border border-gray-600">
                    <div>
                        <h4 class="text-sm font-bold text-white"><%= player.name %></h4>
                        <!-- <p class="text-[10px] text-gray-400 uppercase tracking-tight"><%= player.auctionCategory %> • <%= player.category %></p> -->
                         <% 
                                let tierColor = 'text-slate-300 border-white/40 bg-slate-600/60  px-6 py-1'; 
                                if(player.auctionCategory === 'Platinum') tierColor = 'text-blue-400 bg-blue-900/40 border-blue-700 font-bold px-3 py-1'; 
                                else if(player.auctionCategory === 'Diamond') tierColor = 'text-purple-400 bg-purple-900/40 border-purple-700 px-3 py-1';
                                else if(player.auctionCategory === 'Gold') tierColor = 'text-yellow-400 bg-yellow-900/30 border-yellow-700  px-6 py-1';
                            %>
                            <span class="text-[10px] uppercase tracking-wider px-3 py-1 rounded-full border <%= tierColor %>">
                                <%= player.auctionCategory %>
                            </span>
                            
                            
                            
                        </div>
                        <div>

                            <span class="inline-flex items-center gap-2">
                               <% if (player.category === 'Batsman') { %>
                                   <img src="/images/cricket-icons/bat.png" class="w-10 h-8">
                               <% } else if (player.category === 'Bowler') { %>
                                   <img src="/images/cricket-icons/Ball.png" class="w-8 h-8">
                               <% } else if (player.category === 'All-rounder') { %>
                                   <img src="/images/cricket-icons/BatsAndBoll.png" class="w-10 h-8">
                               <% } else if (player.category === 'Wicket-keeper-batsman') { %>
                                   <img src="/images/cricket-icons/Bat.png" class="w-8 h-8">
                                   <img src="/images/cricket-icons/glovesGreen.png" class="w-8 h-8">
                               <% } %>
                           </span>
                        </div>
                </div>
                <div class="flex flex-col items-end space-y-2">
                    <% if (player.isSold) { %>
                        <span class="text-[10px] bg-green-900/30 text-green-400 px-2 py-0.5 rounded border border-green-800">SOLD</span>
                    <% } else { %>
                        <span class="text-[10px] bg-gray-700 text-gray-400 px-2 py-0.5 rounded border border-gray-600">UNSOLD</span>
                    <% } %>
                    <a href="/player/profile/<%= player.hashedId %>" class="text-blue-400 text-xs font-semibold">View Profile →</a>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- Gemini code finish -->

                        <div class="px-6 py-4 bg-gray-800/50 border-t border-gray-700 flex items-center justify-between">
                            <div class="text-xs text-gray-400">
                                Showing page <span class="text-white font-semibold"><%= currentPage %></span> of <span class="text-white font-semibold"><%= totalPages %></span>
                            </div>

                            <div class="flex items-center gap-2">
                                <% if (currentPage > 1) { %>
                                    <a href="?page=<%= currentPage - 1 %>" class="p-2 rounded-lg bg-gray-700 hover:bg-gray-600 text-gray-300 transition-all border border-gray-600">
                                        <i class="fas fa-chevron-left text-xs"></i>
                                    </a>
                                <% } else { %>
                                    <button disabled class="p-2 rounded-lg bg-gray-800 text-gray-600 border border-gray-700 cursor-not-allowed">
                                        <i class="fas fa-chevron-left text-xs"></i>
                                    </button>
                                <% } %>

                                <div class="flex gap-1">
                                    <% for(let i = 1; i <= totalPages; i++) { %>
                                        <a href="?page=<%= i %>" 
                                           class="px-3 py-1 rounded-md text-xs font-medium transition-all <%= currentPage === i ? 'bg-blue-600 text-white shadow-lg' : 'bg-gray-700 text-gray-400 hover:bg-gray-600' %>">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                </div>

                                <% if (currentPage < totalPages) { %>
                                    <a href="?page=<%= currentPage + 1 %>" class="p-2 rounded-lg bg-gray-700 hover:bg-gray-600 text-gray-300 transition-all border border-gray-600">
                                        <i class="fas fa-chevron-right text-xs"></i>
                                    </a>
                                <% } else { %>
                                    <button disabled class="p-2 rounded-lg bg-gray-800 text-gray-600 border border-gray-700 cursor-not-allowed">
                                        <i class="fas fa-chevron-right text-xs"></i>
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>
</body>
</html>