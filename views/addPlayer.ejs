<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Add Player</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100 flex justify-center items-center min-h-screen">
    <div class="bg-white p-8 rounded shadow-md w-full max-w-lg">
      <h2 class="text-2xl font-bold mb-6 text-center">Add New Player</h2>

      <form
        action="/api/player/"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-4"
      >
        <!-- Name -->
        <input
          type="text"
          name="name"
          placeholder="Player Name"
          class="w-full px-4 py-2 border rounded-md focus:outline-none focus:border-transparent focus:ring-2 focus:ring-red-500 bg-transparent text-white"
          required
        />

        <!-- Email -->
        <input
          type="email"
          name="email"
          placeholder="Email"
          class="w-full px-4 py-2 border rounded-md focus:outline-none focus:border-transparent focus:ring-2 focus:ring-red-500 bg-transparent text-white"
          required
        />

        <!-- Phone Number -->
        <input
          type="text"
          name="phoneNumber"
          placeholder="Phone Number"
          class="w-full px-4 py-2 border rounded-md focus:outline-none focus:border-transparent focus:ring-2 focus:ring-red-500 bg-transparent text-white"
        />

        <!-- Player Image -->
        <input
          type="file"
          name="playerImage"
          accept="image/*"
          class="w-full px-4 py-2 border rounded-md focus:outline-none focus:border-transparent focus:ring-2 focus:ring-red-500 bg-transparent text-white"
        />

        <!-- Playing Style -->
        <select name="playingStyle" class="w-full p-2 border rounded" required>
          <option value="right-handed">Right-handed</option>
          <option value="left-handed">Left-handed</option>
        </select>

        <!-- Category -->
        <select name="category" class="w-full p-2 border rounded" required>
          <option value="Batsman">Batsman</option>
          <option value="Bowler">Bowler</option>
          <option value="All-rounder">All-rounder</option>
          <option value="Wicket-keeper-batsman">Wicket-keeper-batsman</option>
        </select>

        <!-- Batting Order -->

        <!-- <select name="battingOrder" class="w-full p-2 border rounded">
          <option value="Top-order">Top-order</option>
          <option value="Middle-order">Middle-order</option>
          <option value="Lower-order">Lower-order</option>
        </select> -->

        <!-- Bowling Type -->

        <!-- <select name="bowlingType" class="w-full p-2 border rounded">
          <option value="Fast">Fast</option>
          <option value="Medium">Medium</option>
          <option value="Spin">Spin</option>
        </select> -->

        <!-- Team ID -->

        <!-- <input
          type="number"
          name="teamId"
          placeholder="Team ID (optional)"
          class="w-full p-2 border rounded"
        /> -->

        <!-- Auction Category -->

        <!-- <select
          name="auctionCategory"
          class="w-full p-2 border rounded"
          required
        >
          <option value="Platinum">Platinum</option>
          <option value="Diamond">Diamond</option>
          <option value="Gold">Gold</option>
          <option value="Silver">Silver</option>
        </select> -->

        <!-- Sold Status -->

        <!-- <label class="flex items-center space-x-2">
          <input
            type="checkbox"
            name="isSold"
            value="true"
            class="form-checkbox"
          />
          <span>Player Sold?</span>
        </label> -->

        <!-- Sold Price -->

        <input
          type="number"
          name="soldPrice"
          placeholder="Sold Price (optional)"
          class="w-full p-2 border rounded"
        />

        <button
          type="submit"
          class="w-full bg-green-600 text-white p-2 rounded hover:bg-green-700"
        >
          Add Player
        </button>
      </form>
    </div>
  </body>
</html>
