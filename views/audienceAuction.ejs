<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>LIVE AUCTION | PROJECTOR VIEW</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .glow { text-shadow: 0 0 20px rgba(74, 222, 128, 0.5); }
        .bg-animate { background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%); }
        
        /* Smooth fade transition for images */
        #proj-img { transition: opacity 0.5s ease-in-out; }
        
        /* Animation for when a new bid comes in */
        @keyframes bid-pulse {
            0% { transform: scale(1); color: #4ade80; }
            50% { transform: scale(1.1); color: #fff; }
            100% { transform: scale(1); color: #4ade80; }
        }
        .bid-new { animation: bid-pulse 0.5s ease-out; }
    </style>
</head>

<body class="bg-animate h-screen w-screen flex flex-col items-center justify-center text-white overflow-hidden">

    <div id="waiting-ui" class="text-center">
        <h1 class="text-8xl font-black tracking-tighter animate-pulse mb-4 text-gray-700 uppercase">AuctionPro</h1>
        <p id="waiting-msg" class="text-2xl text-blue-500 font-mono tracking-widest uppercase">Waiting for Session to Begin</p>
    </div>

    <div id="active-ui" class="hidden w-full max-w-7xl px-12 grid grid-cols-2 gap-16 items-center">
        <div class="relative">
            <div class="absolute -inset-4 bg-blue-500/20 blur-3xl rounded-full"></div>
            <img id="proj-img" src=""
                class="relative h-[600px] w-full object-cover rounded-3xl border-8 border-white/10 shadow-2xl opacity-0">
        </div>
        <div class="space-y-8">
            <div>
                <h2 id="proj-name" class="text-8xl font-black leading-none mb-4 uppercase">---</h2>
                <p id="proj-cat" class="text-3xl text-blue-400 font-bold uppercase tracking-widest">---</p>
            </div>
            <div class="bg-black/40 backdrop-blur-md p-10 rounded-3xl border border-white/10">
                <p class="text-gray-400 text-xl font-bold uppercase mb-2 text-center lg:text-left">Current Bid</p>
                <p id="proj-bid" class="text-9xl font-black text-green-400 glow">$0</p>
                <div id="proj-bidder-label" class="mt-6 text-gray-500 text-sm font-bold uppercase">Leading Bidder</div>
                <div id="proj-bidder" class="text-4xl font-black text-white uppercase italic tracking-tight">---</div>
            </div>
        </div>
    </div>

    <script>
        const waitingUI = document.getElementById('waiting-ui');
        const waitingMsg = document.getElementById('waiting-msg');
        const activeUI = document.getElementById('active-ui');
        const projImg = document.getElementById('proj-img');
        const projName = document.getElementById('proj-name');
        const projCat = document.getElementById('proj-cat');
        const projBid = document.getElementById('proj-bid');
        const projBidder = document.getElementById('proj-bidder');

        let lastBid = 0;
        let currentPlayerId = null;

        function updateUI(data) {
            // Handle Session Offline
            if (!data.isSessionActive) {
                waitingUI.classList.remove('hidden');
                activeUI.classList.add('hidden');
                waitingMsg.textContent = "Auction System Offline";
                return;
            }

            // Handle Session Online but No Active Player
            if (!data.auction || !data.auction.player) {
                waitingUI.classList.remove('hidden');
                activeUI.classList.add('hidden');
                waitingMsg.textContent = "Waiting for Player to be Called";
                currentPlayerId = null; // Reset player tracking
                return;
            }

            // Transition to Active UI
            waitingUI.classList.add('hidden');
            activeUI.classList.remove('hidden');

            const player = data.auction.player;

            // 1. Detect if the player has changed (prevents image flickering)
            if (currentPlayerId !== player.id) {
                currentPlayerId = player.id;
                projImg.style.opacity = '0'; // Fade out old image
                
                setTimeout(() => {
                    projName.textContent = player.name;
                    projCat.textContent = player.category || '---';
                    projImg.src = player.playerImage || '/images/default-player.png';
                    projImg.style.opacity = '1'; // Fade in new image
                }, 300);
            }

            // 2. Handle Bid Updates with Visual Feedback
            const newBid = data.auction.currentBid;
            if (newBid !== lastBid) {
                projBid.textContent = '$' + newBid.toLocaleString();
                
                // Add pulse animation for new bid
                projBid.classList.remove('bid-new');
                void projBid.offsetWidth; // Trigger reflow to restart animation
                projBid.classList.add('bid-new');
                
                lastBid = newBid;
            }

            // 3. Update Bidder Name
            if (data.auction.highestBidder) {
                projBidder.textContent = data.auction.highestBidder.name;
                projBidder.classList.remove('text-gray-600');
            } else {
                projBidder.textContent = 'Opening Bid';
                projBidder.classList.add('text-gray-600');
            }
        }

        async function pollState() {
            try {
                const res = await fetch('/api/auction/state');
                if (!res.ok) throw new Error('Network response was not ok');
                const data = await res.json();
                updateUI(data);
            } catch (err) {
                console.error('Polling error:', err);
                // Keep the last state visible but perhaps dim the UI to show connection error
            }
        }

        // Initialize and Start Polling
        pollState(); 
        setInterval(pollState, 1000); // Poll every 1 second
    </script>
</body>
</html>