<!DOCTYPE html>
<html>
  <head>
    <title>Admin Sign Up</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <!-- Background Video -->
    <div class="absolute inset-0 overflow-hidden -z-10">
      <iframe
        class="w-full h-full absolute top-0 left-0 object-cover"
        src="https://www.youtube.com/embed/pJEZpSwrIgA?autoplay=1&mute=1&loop=1&playlist=pJEZpSwrIgA&controls=0&modestbranding=1&showinfo=0&rel=0&iv_load_policy=3&disablekb=1"
        frameborder="0"
        allow="autoplay; fullscreen"
        allowfullscreen
      ></iframe>
    </div>

    <!-- <video autoplay muted loop class="absolute w-full h-full object-cover">
      <source src="/videos/cricketShort.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video> -->

    <!-- Overlay -->
    <div class="absolute w-full h-full bg-black bg-opacity-50"></div>

    <div class="b-black/50 p-8 z-10 rounded-lg shadow-md w-full max-w-md">
      <h2 class="text-4xl font-bold text-center mb-8 text-red-600">
        Admin Sign Up
      </h2>

      <form
        action="/api/auth/signup"
        method="GET"
        class="space-y-4 text-white/70"
      >
        <div>
          <label class="block mb-2">Full Name</label>
          <input
            type="text"
            name="name"
            placeholder="Enter full name"
            required
            class="w-full px-4 py-2 border rounded-md focus:outline-none focus:border-transparent focus:ring-2 focus:ring-red-500 bg-transparent"
          />
        </div>

        <div>
          <label class="block mb-2">Email</label>
          <input
            type="email"
            name="email"
            placeholder="Enter admin email"
            required
            class="w-full px-4 py-2 border rounded-md focus:outline-none focus:border-transparent focus:ring-2 focus:ring-red-500 bg-transparent"
          />
        </div>

        <div>
          <label class="block mb-2">Password</label>
          <input
            type="password"
            name="password"
            placeholder="Enter password"
            required
            class="w-full px-4 py-2 border rounded-md focus:outline-none focus:border-transparent focus:ring-2 focus:ring-red-500 bg-transparent"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-red-600 text-white py-2 rounded-md hover:bg-red-700 transition"
        >
          Sign Up
        </button>

        <p class="text-center mt-4">
          Already have an account?
          <a href="/admin/signin/video" class="text-red-600 hover:underline"
            >Sign In</a
          >
        </p>
      </form>
    </div>
  </body>
</html>
