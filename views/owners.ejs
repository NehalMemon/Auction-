<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Auction System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1f2937; }
        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #6b7280; }
    </style>
</head>

<body class="bg-gray-900 text-gray-100 font-sans antialiased">

    <div class="flex h-screen overflow-hidden">

        <aside class="w-64 bg-gray-800 border-r border-gray-700 hidden md:flex flex-col">
            <div class="h-16 flex items-center justify-center border-b border-gray-700">
                <h1 class="text-2xl font-bold text-blue-500 tracking-wider">AUCTION<span class="text-white">PRO</span></h1>
            </div>

            <nav class="flex-1 px-4 py-6 space-y-2">
                <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Main</p>
                
                <a href="/auth/admin/dashboard" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors">
                    <i class="fas fa-th-large w-6"></i>
                    <span class="font-medium">Dashboard</span>
                </a>

                <a href="/admin/owners" class="flex items-center px-4 py-3 bg-gray-700 text-white rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-users w-6"></i>
                    <span class="font-medium">Owners</span>
                </a>

                <a href="#" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors">
                    <i class="fas fa-running w-6"></i>
                    <span class="font-medium">Players</span>
                </a>
            </nav>

            <div class="p-4 border-t border-gray-700">
                <form action="/auth/admin/signout" method="POST">
                    <button type="submit" class="flex items-center w-full px-4 py-2 text-red-400 hover:bg-red-500/10 rounded-lg transition-colors">
                        <i class="fas fa-sign-out-alt w-6"></i>
                        <span class="font-medium">Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden relative">

            <header class="h-16 bg-gray-800 border-b border-gray-700 flex items-center justify-between px-8">
                <div class="flex items-center gap-4">
                    <button class="md:hidden text-gray-400 hover:text-white"><i class="fas fa-bars text-xl"></i></button>
                    <h2 class="text-xl font-semibold text-gray-200">Manage Owners</h2>
                </div>
                
                <div class="flex items-center space-x-4">
                    <div class="h-10 w-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold border-2 border-gray-600">
                        <i class="fas fa-user-shield"></i>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-900 p-8">

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
                    <div>
                        <a href="/auth/admin/dashboard" class="text-gray-400 hover:text-white mb-2 inline-block transition-colors">
                            <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
                        </a>
                        <h3 class="text-3xl font-bold text-white">All Owners</h3>
                        <p class="text-gray-400 text-sm mt-1">View and manage all registered team owners.</p>
                    </div>
                    <a href="/admin/add-owner" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg font-medium shadow-lg hover:shadow-blue-500/20 transition-all flex items-center gap-2">
                        <i class="fas fa-plus"></i> Add New Owner
                    </a>
                </div>

                <div class="bg-gray-800 rounded-xl border border-gray-700 shadow-xl overflow-hidden">
                    
                    <% if (owners.length === 0) { %>
                        <div class="p-12 text-center text-gray-500">
                            <div class="mb-4 bg-gray-700/50 h-20 w-20 rounded-full flex items-center justify-center mx-auto">
                                <i class="fas fa-users-slash text-3xl"></i>
                            </div>
                            <h4 class="text-xl font-medium text-white">No Owners Found</h4>
                            <p class="mt-2 text-sm">Get started by adding a new team owner to the system.</p>
                        </div>
                    <% } else { %>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-gray-700/50 text-xs uppercase text-gray-400 font-semibold tracking-wider">
                                    <tr>
                                        <th class="px-6 py-4">Owner Name</th>
                                        <th class="px-6 py-4">Email</th>
                                        <th class="px-6 py-4">Joined Date</th>
                                        <th class="px-6 py-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-700">
                                    <% owners.forEach(owner => { %>
                                        <tr class="hover:bg-gray-700/30 transition-colors group">
                                            
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="flex items-center">
                                                    <div class="h-10 w-10 flex-shrink-0">
                                                        <% if (owner.image) { %>
                                                            <img class="h-10 w-10 rounded-full object-cover border border-gray-600" src="<%= owner.image %>" alt="<%= owner.name %>">
                                                        <% } else { %>
                                                            <div class="h-10 w-10 rounded-full bg-yellow-500 flex items-center justify-center text-gray-900 font-bold text-sm shadow-md">
                                                                <%= owner.name.charAt(0).toUpperCase() %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div class="ml-4">
                                                        <div class="text-sm font-medium text-white group-hover:text-blue-400 transition-colors"><%= owner.name %></div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="text-sm text-gray-300"><%= owner.email %></div>
                                            </td>

                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                                                <%= new Date(owner.createdAt).toLocaleDateString() %>
                                            </td>

                                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                                <a href="#" class="text-blue-400 hover:text-blue-300 mr-4 transition-colors" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="#" class="text-red-400 hover:text-red-300 transition-colors" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>

</body>
</html>