<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alert</title>
</head>
<body>
    <div class="fixed top-5 right-5 z-50 w-full max-w-sm px-4 space-y-3">

  <% if (locals.success_msg && locals.success_msg.length > 0) { %>
    <div class="flex items-center gap-4 bg-green-600/20 border-l-4 border-green-500 text-green-800 p-4 rounded-xl shadow-lg backdrop-blur-sm animate-fade-in">
      <div class="flex-shrink-0">
        <i class="fas fa-check-circle text-green-500 text-2xl"></i>
      </div>
      <div class="flex-1">
        <p class="font-semibold text-green-700">Success!</p>
        <p class="text-green-800 text-sm"><%= success_msg %></p>
      </div>
      <button onclick="this.parentElement.remove()" class="text-green-500 hover:text-green-700 ml-2">
        <i class="fas fa-times"></i>
      </button>
    </div>
  <% } %>

  <% if (locals.error_msg && locals.error_msg.length > 0) { %>
     <div class="flex items-center gap-4 bg-red-600/20 border-l-4 border-red-500 text-red-800 p-4 rounded-xl shadow-lg backdrop-blur-sm animate-fade-in">
      <div class="flex-shrink-0">
        <i class="fas fa-exclamation-circle text-red-500 text-2xl"></i>
      </div>
      <div class="flex-1">
        <p class="font-semibold text-red-700">Error!</p>
        <p class="text-red-800 text-sm"><%= error_msg %></p>
      </div>
      <button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700 ml-2">
        <i class="fas fa-times"></i>
      </button>
    </div>
  <% } %>

</div>

<script>
  // Wait for the DOM to fully load
  document.addEventListener('DOMContentLoaded', () => {
    // Select all alert elements
    const alerts = document.querySelectorAll('.animate-fade-in');

    alerts.forEach((alert) => {
      // Set the timer (5000ms = 5 seconds)
      setTimeout(() => {
        // Step 1: Add a transition for a smooth disappear effect
        alert.style.transition = "opacity 0.6s ease, transform 0.6s ease";
        alert.style.opacity = "0";
        alert.style.transform = "translateX(20px)"; // Moves slightly right while fading

        // Step 2: Physically remove the element from DOM after transition ends
        setTimeout(() => {
          alert.remove();
        }, 600); // This matches the 0.6s transition time
      }, 5000); 
    });
  });
</script>

</body>
</html>