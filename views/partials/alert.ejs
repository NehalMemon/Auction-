<div class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] w-full max-w-sm px-4">

    <% if (locals.success_msg && success_msg.length > 0) { %>
        <div class="alert-box flex items-center gap-4 bg-black/80 border-2 border-green-500 p-4 rounded-xl shadow-lg backdrop-blur-md animate-fade-in">
            <div class="flex-shrink-0"><i class="fas fa-check-circle text-green-500 text-3xl"></i></div>
            <div class="flex-1">
                <p class="font-bold text-green-500 text-sm">SUCCESS</p>
                <p class="text-white font-medium text-xs"><%= Array.isArray(success_msg) ? success_msg[0] : success_msg %></p>
            </div>
            <button onclick="closeAlert(this)" class="text-gray-400 hover:text-white"><i class="fas fa-times"></i></button>
        </div>

    <% } else if (locals.error_msg && error_msg.length > 0) { %>
        
        <div class="alert-box flex items-center gap-4 bg-black/80 border-2 border-red-500 p-4 rounded-xl shadow-lg backdrop-blur-md animate-fade-in">
            <div class="flex-shrink-0"><i class="fas fa-exclamation-triangle text-red-500 text-3xl"></i></div>
            <div class="flex-1">
                <p class="font-bold text-red-500 text-sm">ERROR</p>
                <p class="text-white font-medium text-xs"><%= Array.isArray(error_msg) ? error_msg[0] : error_msg %></p>
            </div>
            <button onclick="closeAlert(this)" class="text-gray-400 hover:text-white"><i class="fas fa-times"></i></button>
        </div>

    <% } %>

</div>


