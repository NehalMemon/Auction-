<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Auction System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Custom Scrollbar for Dark Theme */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1f2937; }
        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #6b7280; }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 font-sans antialiased">

    <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-50 w-full max-w-md px-4 space-y-4">
        <% if (locals.success_msg && locals.success_msg.length > 0) { %>
            <div class="bg-green-500/10 border-l-4 border-green-500 text-green-400 p-4 rounded shadow-2xl backdrop-blur-sm flex items-center justify-between animate-bounce" role="alert">
                <div><span class="font-bold">Success:</span> <%= success_msg %></div>
            </div>
        <% } %>
        <% if (locals.error_msg && locals.error_msg.length > 0) { %>
            <div class="bg-red-500/10 border-l-4 border-red-500 text-red-400 p-4 rounded shadow-2xl backdrop-blur-sm flex items-center justify-between" role="alert">
                <div><span class="font-bold">Error:</span> <%= error_msg %></div>
            </div>
        <% } %>
    </div>

    <div class="flex h-screen overflow-hidden">

        <aside class="w-64 bg-gray-800 border-r border-gray-700 hidden md:flex flex-col">
            <div class="h-16 flex items-center justify-center border-b border-gray-700">
                <h1 class="text-2xl font-bold text-blue-500 tracking-wider">AUCTION<span class="text-white">PRO</span></h1>
            </div>

            <nav class="flex-1 px-4 py-6 space-y-2">
                <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Main</p>
                
                <!-- <a href="/admin/dashboard" class="flex items-center px-4 py-3 bg-gray-700 text-white rounded-lg transition-colors shadow-sm"> -->
                <a href="/admin/dashboard" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white  rounded-lg transition-colors shadow-sm
                       <%= currentPath === '/admin/dashboard'
                         ? 'bg-gray-700 text-white'
                         : '' %>">
                    <i class="fas fa-th-large w-6"></i>
                    <span class="font-medium">Dashboard</span>
                </a>

                <a href="/owner/ownerslist" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors   
                <%= currentPath === '/owner/ownerslist'
                         ? 'bg-gray-700 text-white'
                         : '' %>">
                    <i class="fas fa-users w-6"></i>
                    <span class="font-medium">Owners</span>
                </a>

                <a href="/player/playerslist" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors
                <%= currentPath === '/player/playerslist'
                         ? 'bg-gray-700 text-white'
                         : '' %>">
                    <i class="fas fa-running w-6"></i>
                    <span class="font-medium">Players</span>
                </a>
                <a href="/player/teamslist" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors
                <%= currentPath === '/player/teamslist'
                         ? 'bg-gray-700 text-white'
                         : '' %>">
                    <i class="fas fa-running w-6"></i>
                    <span class="font-medium">Teams</span>
                </a>

                <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mt-8 mb-2">System</p>

                <a href="#" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors
                <%= currentPath === '#'
                         ? 'bg-gray-700 text-white'
                         : '' %>">
                    <i class="fas fa-gavel w-6"></i>
                    <span class="font-medium">Live Auction</span>
                </a>

                <a href="#" class="flex items-center px-4 py-3 text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg transition-colors
                <%= currentPath === '#'
                         ? 'bg-gray-700 text-white'
                         : '' %>">
                    <i class="fas fa-cog w-6"></i>
                    <span class="font-medium">Settings</span>
                </a>
            </nav>

            <div class="p-4 border-t border-gray-700">
                <form action="/auth/admin/signout" method="POST">
                    <button type="submit" class="flex items-center w-full px-4 py-2 text-red-400 hover:bg-red-500/10 rounded-lg transition-colors">
                        <i class="fas fa-sign-out-alt w-6"></i>
                        <span class="font-medium">Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>


          

</body>
</html>